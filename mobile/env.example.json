# Copy values ke `--dart-define` saat run/build, atau gunakan file IDE launch config.
# Contoh:
#   flutter run --dart-define-from-file=env.json
# Buat env.json dari salinan file ini (env.json di-gitignore).

API_BASE_URL=http://127.0.0.1:8000/api/v1

# Android emulator → host machine: http://10.0.2.2:8000/api/v1
# iOS simulator: http://127.0.0.1:8000/api/v1

# Google OAuth — Client IDs dari Google Cloud Console
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Firebase (FCM) — project id untuk setup native (google-services.json / GoogleService-Info.plist)
FIREBASE_PROJECT_ID=
